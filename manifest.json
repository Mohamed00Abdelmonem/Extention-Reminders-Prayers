{
  "manifest_version": 3,
  "name": "Taqwa – Prayer Times, Azkar & Quran Radio",
  "version": "1.2.0",
  "description": "Taqwa – Prayer Times, Azkar & Quran Radio is a lightweight Chrome extension that helps you stay consistent with your daily prayers.",
  "permissions": ["alarms", "notifications", "offscreen", "storage"],
  "host_permissions": ["https://api.aladhan.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; media-src 'self' http://* https://*"
  },
  "web_accessible_resources": [
    {
      "resources": ["adhan.mp3"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Taqwa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
